{
  "name": "stagepass",
  "private": true,
  "version": "1.0.0",
  "description": "StagePass Creative Assets & Music Licensing Platform",
  "author": "Shashvat Biswas <aaravaadit2002@gmail.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mobile:sync": "npm run build && npx cap sync",
    "electron:start": "electron .",
    "electron:build": "npm run build && powershell -Command \"Remove-Item -Path 'dist-desktop' -Recurse -Force -ErrorAction SilentlyContinue\" && electron-builder"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.1.1",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.stagepass.desktop",
    "productName": "StagePass Desktop",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
